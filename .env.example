# Copy to .env and fill in. NEVER commit the filled-in .env - it is gitignored.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Local Postgres on the default port (Homebrew, or any local install):
DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5432/pharmacy_crm?schema=public"
# If you use the bundled docker-compose.yml instead, it publishes 5433 to avoid clashing
# with a local Postgres:
# DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5433/pharmacy_crm?schema=public"
# AWS RDS / DigitalOcean Managed Postgres - note sslmode=require:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pharmacy_crm?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# The ONE public address of this deployment. Every absolute URL the application shows the
# outside world is built from it: unsubscribe links in real email, the OAuth redirect, the
# redirect after sign-in. It must match the address a browser actually reaches, exactly -
# scheme, host and port.
#
# The CRM is designed to live on a SUBDOMAIN, so the company's root domain stays free for a
# future website, store or customer portal:
#
#   Development   http://localhost:3000
#   Staging       https://crm-staging.example.com
#   Production    https://crm.example.com
#
# Production must be https://. Session cookies are marked Secure, so over plain HTTP the
# browser will not send them back and nobody can sign in - the app refuses to start rather
# than let that reach a user.
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# First operator account. Seeded once on an empty database, as OWNER; further accounts and
# their roles are managed in the CRM at /settings/users.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL="you@example.com"
# scrypt hash, format: scrypt:<salt>:<hash>. Generate it with:
#   npm run hash:password -- 'your-password'
# Colons, not "$": Next expands $VAR references when it loads this file, so a "$" form is
# silently truncated and every login then fails. The plaintext password is NEVER stored anywhere.
ADMIN_PASSWORD_HASH=""
# Random 32+ byte secret. Signs the session cookie and the unsubscribe tokens.
# The app refuses to start signing anything if this is empty - there is no fallback key.
#   openssl rand -hex 32
SESSION_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Token encryption
# ─────────────────────────────────────────────────────────────────────────────
# 64 hex characters = 32 bytes, used for AES-256-GCM encryption of Gmail refresh
# tokens at rest.  openssl rand -hex 32
# Rotating this invalidates every stored refresh token; mailboxes must reconnect.
TOKEN_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Data import and email verification
# ─────────────────────────────────────────────────────────────────────────────
# Where uploaded source files are kept. The original file is the only true record of what a
# source supplied, so it is retained rather than discarded after parsing. In a container this
# needs a volume, or the files go when the container does.
IMPORT_STORAGE_DIR="./storage/imports"

# Email verification through Reoon (https://emailverifier.reoon.com).
#
# With a key, a round is submitted to Reoon's bulk API and the results are written back the moment
# the task completes. Without one the same round still works as a file exchange: export the CSV,
# run it through any verifier, paste the results back.
#
# Reoon caps a task at 50,000 addresses and charges per distinct address - duplicates are removed
# before billing. Credits are visible on the Email Verification page once a key is set.
REOON_API_KEY=""
# Kept for a future provider; REOON_API_KEY takes precedence.
EMAIL_VERIFIER_PROVIDER="reoon"
EMAIL_VERIFIER_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Platform maintenance access
# ─────────────────────────────────────────────────────────────────────────────
# Break-glass account. It can suspend and resume the whole application; while suspended no
# operator - including an owner - can sign in, live sessions stop resolving, and the worker sends
# and syncs nothing.
#
# The names are deliberately unremarkable, but that is a courtesy rather than a control: anyone
# who can read this file or the container environment can find them. What protects the account is
# the hash below and the permission check in the code.
#
# Only a scrypt hash is stored, exactly like ADMIN_PASSWORD_HASH:
#   npm run hash:password -- 'a long random password'
# Leave all three blank to disable break-glass access entirely.
PLATFORM_KEY_ID=""
PLATFORM_KEY_HASH=""
# Unlisted path for the maintenance console. Not linked from anywhere in the UI; any other path
# 404s. Change it to something only you know.
PLATFORM_CONSOLE_PATH="ops-console"

# ─────────────────────────────────────────────────────────────────────────────
# Email mode  ── THE TWO SWITCHES THAT LET MAIL LEAVE THE APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
# mock  = every provider call is simulated in-process. Nothing reaches the internet.
# gmail = the real Gmail API, but see ENABLE_LIVE_EMAIL_SENDING below.
EMAIL_MODE="mock"
# Real sending requires BOTH EMAIL_MODE=gmail AND this set to true. Default: false.
ENABLE_LIVE_EMAIL_SENDING="false"
# When live, ONLY these addresses may be sent to. An empty list blocks every address,
# which is the safe default. Use internal/test addresses - never arbitrary pharmacies.
LIVE_EMAIL_TEST_ALLOWLIST=""

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (only needed for EMAIL_MODE=gmail)
# ─────────────────────────────────────────────────────────────────────────────
# Scopes requested: gmail.send, gmail.readonly, userinfo.email. Nothing broader.
# The client secret and refresh tokens are server-side only and are never sent to the browser.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#
# GOOGLE_REDIRECT_URI must sit under APP_URL and must be registered, character for character,
# as an Authorized redirect URI in the Google Cloud console. Each environment needs its own
# entry - never point production OAuth at a development callback:
#
#   Development   http://localhost:3000/api/oauth/google/callback
#   Production    https://crm.example.com/api/oauth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"

# ─────────────────────────────────────────────────────────────────────────────
# Responsible sending limits
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_MAILBOX_DAILY_LIMIT="20"
GLOBAL_DAILY_LIMIT="200"
MIN_DELAY_SECONDS="45"
MAX_DELAY_SECONDS="120"

# Ramp caps. An operational volume control, not a spam-filter evasion technique.
RAMP_NEW_LIMIT="20"
RAMP_RAMPING_LIMIT="40"
RAMP_ESTABLISHED_LIMIT="100"

# Retries. A send that fails for our own reasons is tried again with exponential backoff; a
# recipient that runs out of attempts is left FAILED rather than retried forever. A claim held
# longer than the timeout means the worker died mid-send, and the row is returned to the queue.
MAX_SEND_ATTEMPTS="3"
RETRY_BACKOFF_MINUTES="5"
SEND_CLAIM_TIMEOUT_MINUTES="10"

# Automatic safety brakes. A tripped mailbox is paused and stays paused until a human resumes it.
BOUNCE_RATE_PAUSE_THRESHOLD="5"      # percent
BOUNCE_CHECK_MIN_SENDS="20"          # no bounce-rate judgement below this many sends
CONSECUTIVE_FAILURE_THRESHOLD="5"

# Default sending window. The campaign's own timezone governs, never the server's.
DEFAULT_TIMEZONE="America/New_York"
DEFAULT_SENDING_START="09:00"
DEFAULT_SENDING_END="16:00"

# ─────────────────────────────────────────────────────────────────────────────
# Company identity (CAN-SPAM footer). Also editable at /settings, which overrides these.
# A physical postal address is legally required on commercial email.
# ─────────────────────────────────────────────────────────────────────────────
COMPANY_NAME=""
COMPANY_ADDRESS=""
COMPANY_WEBSITE=""

# ─────────────────────────────────────────────────────────────────────────────
# Worker
# ─────────────────────────────────────────────────────────────────────────────
WORKER_TICK_MS="15000"
WORKER_SYNC_EVERY_TICKS="20"
